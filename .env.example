# Never commit a real key. Use the platform secret manager.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2023-06-01
INPUT_COST_PER_MTOK=0
OUTPUT_COST_PER_MTOK=0
PORT=3000
APP_ENV=development
AUTH_MODE=none
SECRET_SOURCE=local-environment
AUDIT_SINK=stdout
TELEMETRY_EXPORTER=console
REQUEST_TIMEOUT_MS=30000
MAX_CONCURRENT_REQUESTS=20
RATE_LIMIT_PER_MINUTE=60
MODEL_MAX_ATTEMPTS=1
MODEL_MAX_OUTPUT_TOKENS=700
MONTHLY_MODEL_BUDGET_USD=0
MIN_REPLICAS=1
MULTI_ZONE=false
AUTOSCALING=false
CARBON_AWARE_REGION=false
INFRASTRUCTURE_AS_CODE=false
AUTOMATIC_ROLLBACK=false
BACKUP_RESTORE_TESTED=false
DATA_RETENTION_DAYS=7

# MCP connector layer. Off by default; there is no live transport and enabling these
# does not create one. See docs/MCP_CONNECTORS.md before changing any of them.
# No variable here carries a credential: MCP_CREDENTIAL_MODE selects a resolver only.
MCP_CONNECTORS_ENABLED=false
MCP_CREDENTIAL_MODE=denied
MCP_ALLOWED_HOSTS=
MCP_AWS_ENABLED=false
MCP_AWS_ENDPOINT_URL=
MCP_GCP_ENABLED=false
MCP_GCP_ENDPOINT_URL=
MCP_MAX_REDIRECTS=0
MCP_ALLOWED_CONTENT_TYPES=application/json
MCP_MAX_CONCURRENT_CALLS=2
