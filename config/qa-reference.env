# Non-secret quality-assurance contract. This is not deployment evidence.
APP_ENV=qa
AUTH_MODE=gateway
SECRET_SOURCE=managed
AUDIT_SINK=stdout
TELEMETRY_EXPORTER=otlp
PORT=3000
REQUEST_TIMEOUT_MS=25000
MAX_CONCURRENT_REQUESTS=30
RATE_LIMIT_PER_MINUTE=90
MODEL_MAX_ATTEMPTS=1
MODEL_MAX_OUTPUT_TOKENS=700
MONTHLY_MODEL_BUDGET_USD=250
MIN_REPLICAS=2
MULTI_ZONE=true
AUTOSCALING=true
CARBON_AWARE_REGION=false
INFRASTRUCTURE_AS_CODE=true
AUTOMATIC_ROLLBACK=true
BACKUP_RESTORE_TESTED=false
DATA_RETENTION_DAYS=7
