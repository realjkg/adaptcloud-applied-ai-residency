# Non-secret reference profile. Inject credentials from a managed secret store.
APP_ENV=production
AUTH_MODE=gateway
SECRET_SOURCE=managed
AUDIT_SINK=managed-immutable
TELEMETRY_EXPORTER=otlp
PORT=3000
REQUEST_TIMEOUT_MS=25000
MAX_CONCURRENT_REQUESTS=100
RATE_LIMIT_PER_MINUTE=300
MODEL_MAX_ATTEMPTS=2
MODEL_MAX_OUTPUT_TOKENS=700
MONTHLY_MODEL_BUDGET_USD=2500
MIN_REPLICAS=2
MULTI_ZONE=true
AUTOSCALING=true
CARBON_AWARE_REGION=true
INFRASTRUCTURE_AS_CODE=true
AUTOMATIC_ROLLBACK=true
BACKUP_RESTORE_TESTED=true
DATA_RETENTION_DAYS=30

# MCP connector layer. Off in every reference profile: enabling an egress path is an owner
# decision with a threat model behind it, not a default. See docs/MCP_CONNECTORS.md.
MCP_CONNECTORS_ENABLED=false
MCP_CREDENTIAL_MODE=denied
