# Non-secret pre-production contract. This is not deployment evidence.
APP_ENV=staging
AUTH_MODE=gateway
SECRET_SOURCE=managed
AUDIT_SINK=managed-immutable
TELEMETRY_EXPORTER=otlp
PORT=3000
REQUEST_TIMEOUT_MS=25000
MAX_CONCURRENT_REQUESTS=50
RATE_LIMIT_PER_MINUTE=120
MODEL_MAX_ATTEMPTS=2
MODEL_MAX_OUTPUT_TOKENS=700
MONTHLY_MODEL_BUDGET_USD=500
MIN_REPLICAS=2
MULTI_ZONE=true
AUTOSCALING=true
CARBON_AWARE_REGION=false
INFRASTRUCTURE_AS_CODE=true
AUTOMATIC_ROLLBACK=true
BACKUP_RESTORE_TESTED=false
DATA_RETENTION_DAYS=14
