{
  "name": "adaptcloud-applied-ai-residency",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Production-shaped Claude agent workflow for Adapt Cloud resident engineers.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && node dist/src/bootstrap.js",
    "dev:env": "npm run build && node --env-file=.env dist/src/bootstrap.js",
    "agent": "npm run build && node dist/src/index.js",
    "scenario": "npm run build && node dist/src/scenario-cli.js",
    "console": "node scripts/serve-console.mjs",
    "eval": "npm run build && node dist/scripts/run-evals.js && node dist/scripts/run-scenario-evals.js",
    "eval:scenarios": "npm run build && node dist/scripts/run-scenario-evals.js",
    "lab:simulate": "npm run build && node dist/scripts/run-lab-simulations.js",
    "lab:simulate:claude": "npm run build && node dist/scripts/run-lab-simulations.js --claude-live",
    "promotion:simulate": "npm run build && node dist/scripts/run-promotion-simulation.js",
    "acceptance:container": "bash scripts/test-container-runtime.sh",
    "acceptance:telemetry": "bash scripts/test-otel-integration.sh",
    "readiness": "npm run build && node dist/scripts/check-readiness.js",
    "readiness:development-reference": "npm run build && node --env-file=config/development-reference.env dist/scripts/check-readiness.js",
    "readiness:sandbox-reference": "npm run build && node --env-file=config/sandbox-reference.env dist/scripts/check-readiness.js",
    "readiness:qa-reference": "npm run build && node --env-file=config/qa-reference.env dist/scripts/check-readiness.js",
    "readiness:staging-reference": "npm run build && node --env-file=config/staging-reference.env dist/scripts/check-readiness.js",
    "readiness:production-reference": "npm run build && node --env-file=config/production-reference.env dist/scripts/check-readiness.js",
    "skills:check": "vitest run tests/skills.test.ts",
    "skills:boundaries": "node .claude/skills/cca-f-architecture-review/scripts/scan-boundaries.mjs",
    "skills:pillars": "node .claude/skills/well-architected-review/scripts/pillar-review.mjs --profile=all",
    "skills:cost": "node .claude/skills/tokenomics-estimate/scripts/estimate-cost.mjs",
    "skills:evidence": "node .claude/skills/promotion-evidence/scripts/evaluate-evidence.mjs --environment=all",
    "skills:probe": "node .claude/skills/scenario-policy/scripts/probe-invariants.mjs",
    "skills:gates": "node .claude/skills/residency-gates/scripts/run-gates.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:regression": "node scripts/run-regression-gate.ts",
    "test:watch": "vitest",
    "smoke:deployment": "node scripts/check-static-deployment.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  }
}
